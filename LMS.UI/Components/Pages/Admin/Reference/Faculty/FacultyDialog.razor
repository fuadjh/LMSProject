@using System.Net.Http.Json
@using MudBlazor
@using WebUi.Components.Crud
@using WebUi.Pages.Admin.Reference.Faculty

@inherits CrudUpsertDialogBase<FacultyUpsertModel>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsEdit ? "ویرایش دانشکده" : "ثبت دانشکده")
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid>
                <MudItem xs="12">
                    <MudSelect T="Guid"
                               @bind-Value="_model.UniversityId"
                               Label="دانشگاه"
                               Variant="Variant.Outlined"
                               Required="true"
                               RequiredError="انتخاب دانشگاه الزامی است."
                               Disabled="@(IsBusy || _loadingUniversities)">

                        @if (_loadingUniversities)
                        {
                            <MudSelectItem T="Guid"
                                           Value="@Guid.Empty"
                                           Disabled="true">
                                در حال بارگذاری...
                            </MudSelectItem>
                        }
                        else
                        {
                            @foreach (var university in _universities)
                            {
                                <MudSelectItem T="Guid"
                                               Value="@university.Id">
                                    @university.Title
                                </MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Title"
                                  Label="عنوان دانشکده"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="عنوان دانشکده الزامی است."
                                  Disabled="IsBusy" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Code"
                                  Label="کد دانشکده"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="کد دانشکده الزامی است."
                                  Disabled="IsBusy" />
                </MudItem>

                @if (IsEdit)
                {
                    <MudItem xs="12">
                        <MudSwitch T="bool"
                                   @bind-Value="_model.IsActive"
                                   Color="Color.Primary"
                                   Disabled="IsBusy">

                            @(_model.IsActive
                                ? "دانشکده فعال است"
                                : "دانشکده غیرفعال است")
                        </MudSwitch>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   Disabled="IsBusy"
                   OnClick="CancelDialog">
            انصراف
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(IsBusy || _loadingUniversities)"
                   OnClick="SubmitAsync">

            @if (IsBusy)
            {
                <MudProgressCircular Indeterminate="true"
                                     Size="Size.Small"
                                     Class="me-2" />
            }

            @(IsEdit ? "ذخیره تغییرات" : "ثبت")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public FacultyUpsertModel? Model { get; set; }

    [Parameter]
    public bool IsEdit { get; set; }

    private MudForm? _form;

    private readonly FacultyUpsertModel _model = new();

    private List<UniversityLookupModel> _universities = [];

    private bool _loadingUniversities;

    protected override string CreateEndpoint =>
        "api/reference-data/faculties";

    protected override string GetUpdateEndpoint(
        FacultyUpsertModel model) =>
        $"api/reference-data/faculties/{model.Id}";

    protected override string CreateSuccessMessage =>
        "دانشکده ثبت شد.";

    protected override string UpdateSuccessMessage =>
        "اطلاعات دانشکده ویرایش شد.";

    protected override void OnParametersSet()
    {
        _model.Id = Model?.Id;
        _model.UniversityId = Model?.UniversityId ?? Guid.Empty;
        _model.UniversityTitle = Model?.UniversityTitle ?? string.Empty;
        _model.Title = Model?.Title ?? string.Empty;
        _model.Code = Model?.Code ?? string.Empty;
        _model.IsActive = Model?.IsActive ?? true;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUniversitiesAsync();
    }

    private async Task LoadUniversitiesAsync()
    {
        _loadingUniversities = true;

        try
        {
            var response =
                await Http.GetFromJsonAsync<PagedUniversitiesResponse>(
                    "api/reference-data/universities" +
                    "?pageNumber=1" +
                    "&pageSize=100" +
                    "&sortBy=title" +
                    "&sortDescending=false");

            _universities = response?.Items
                .Where(x => x.IsActive)
                .OrderBy(x => x.Title)
                .ToList() ?? [];
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(
                "دریافت فهرست دانشگاه‌ها ناموفق بود.",
                Severity.Error);
        }
        finally
        {
            _loadingUniversities = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_form is null ||
            IsBusy ||
            _loadingUniversities)
        {
            return;
        }

        await _form.Validate();

        if (!_form.IsValid)
            return;

        if (_model.UniversityId == Guid.Empty)
        {
            Snackbar.Add(
                "انتخاب دانشگاه الزامی است.",
                Severity.Warning);

            return;
        }

        if (IsEdit && _model.Id is null)
            return;

        _model.Title = _model.Title.Trim();
        _model.Code = _model.Code.Trim();

        await SaveAsync(_model, IsEdit);
    }

    protected override object CreateRequest(
        FacultyUpsertModel model)
    {
        return new
        {
            model.UniversityId,
            model.Title,
            model.Code
        };
    }

    protected override object UpdateRequest(
        FacultyUpsertModel model)
    {
        return new
        {
            Id = model.Id,
            model.UniversityId,
            model.Title,
            model.Code,
            model.IsActive
        };
    }

    private sealed class PagedUniversitiesResponse
    {
        public List<UniversityLookupModel> Items { get; set; } = [];
    }

    private sealed class UniversityLookupModel
    {
        public Guid Id { get; set; }

        public string Title { get; set; } = string.Empty;

        public bool IsActive { get; set; }
    }
}