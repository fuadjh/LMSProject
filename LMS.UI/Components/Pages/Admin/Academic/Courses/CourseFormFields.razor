@using MudBlazor
@using WebUi.Components.Pages.Admin.Academic.Courses


<MudGrid>
    <MudItem xs="12">
        <MudSelect T="Guid?"
        @bind-Value="Model.MajorId"
        Label="رشته"
        Variant="Variant.Outlined"
        For="@(() => Model.MajorId)"
        Disabled="@Model.Id.HasValue">
            @foreach (var major in Model.Majors)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)major.Id)">
                    @major.Title
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudTextField T="string"
        @bind-Value="Model.Code"
        Label="کد درس"
        Variant="Variant.Outlined"
        For="@(() => Model.Code)"
        Immediate="true" />
    </MudItem>

    <MudItem xs="12" md="8">
        <MudTextField T="string"
        @bind-Value="Model.Title"
        Label="عنوان درس"
        Variant="Variant.Outlined"
        For="@(() => Model.Title)"
        Immediate="true" />
    </MudItem>

    <MudItem xs="12" md="4">
        <MudNumericField T="int"
        @bind-Value="Model.Units"
        Label="تعداد واحد"
        Variant="Variant.Outlined"
        For="@(() => Model.Units)"
        Min="1"
        Max="30" />
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired]
    public CourseFormModel Model { get; set; } = default!;
}