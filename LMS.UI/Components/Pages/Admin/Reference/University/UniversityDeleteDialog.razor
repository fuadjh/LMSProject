@using MudBlazor
@using WebUi.Components.Crud
@inherits CrudDeleteDialogBase<Guid>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">حذف دانشگاه</MudText>
    </TitleContent>

    <DialogContent>
        <MudText>
            آیا از حذف دانشگاه «@ItemTitle» مطمئن هستید؟
        </MudText>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   Disabled="IsBusy"
                   OnClick="CancelDialog">
            انصراف
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   Disabled="IsBusy"
                   OnClick="DeleteAsync">
            @if (IsBusy)
            {
                <MudProgressCircular Indeterminate="true"
                                     Size="Size.Small"
                                     Class="me-2" />
            }

            حذف
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    protected override string GetDeleteEndpoint(Guid id) =>
        $"api/reference-data/universities/{id}";

    protected override string DeleteSuccessMessage =>
        "دانشگاه حذف شد.";
}