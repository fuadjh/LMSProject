@page "/admin/academic/course-offerings/{OfferingId:guid}/enrollments"
@using Common.Security
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy =Permissions.CourseOfferings.View)]
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">ثبت‌نام‌های ارائه</MudText>

    <MudTable Items="_items" Dense="true" Hover="true" Class="mt-3">
        <HeaderContent>
            <MudTh>دانشجو</MudTh>
            <MudTh>شماره دانشجویی</MudTh>
            <MudTh>تاریخ ثبت</MudTh>
            <MudTh>وضعیت</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.StudentFullName</MudTd>
            <MudTd>@context.StudentNumber</MudTd>
            <MudTd>@context.EnrolledAtUtc.ToString("yyyy/MM/dd HH:mm")</MudTd>
            <MudTd>@(context.IsActive ? "فعال" : "غیرفعال")</MudTd>
            <MudTd>
                @if (context.IsActive)
                {
                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => DeactivateAsync(context.EnrollmentId))">
                        غیرفعال‌سازی
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    [Parameter] public Guid OfferingId { get; set; }
    private List<EnrollmentVm> _items = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _items = await Http.GetFromJsonAsync<List<EnrollmentVm>>($"api/course-offerings/{OfferingId}/enrollments") ?? new();
    }

    private async Task DeactivateAsync(Guid enrollmentId)
    {
        var response = await Http.DeleteAsync($"api/course-offerings/enrollments/{enrollmentId}");
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await WebUi.Services.ApiErrorReader.ReadErrorAsync(response), Severity.Error);
            return;
        }

        Snackbar.Add("ثبت‌نام غیرفعال شد.", Severity.Success);
        await LoadAsync();
    }

    private sealed class EnrollmentVm
    {
        public Guid EnrollmentId { get; set; }
        public Guid StudentProfileId { get; set; }
        public string StudentFullName { get; set; } = "";
        public string StudentNumber { get; set; } = "";
        public bool IsActive { get; set; }
        public DateTime EnrolledAtUtc { get; set; }
    }
}