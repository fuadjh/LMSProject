@using System.Net.Http.Json
@using MudBlazor
@using WebUi.Components.Crud
@using WebUi.Components.Pages.Admin.Academic.Courses

@inherits CrudUpsertDialogBase<CourseFormModel>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsEdit ? "ویرایش درس" : "ثبت درس")
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex justify-center pa-6">
                <MudProgressCircular Indeterminate="true"
                                     Color="Color.Primary" />
            </div>
        }
        else
        {
            <MudForm @ref="_form">
                <CourseFormFields Model="_model" />
            </MudForm>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text"
                   Disabled="IsBusy"
                   OnClick="CancelDialog">
            انصراف
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="IsBusy || _loading"
                   OnClick="SubmitAsync">

            @if (IsBusy)
            {
                <MudProgressCircular Indeterminate="true"
                                     Size="Size.Small"
                                     Class="me-2" />
            }

            @(IsEdit ? "ذخیره تغییرات" : "ثبت")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public CourseFormModel? Model { get; set; }

    [Parameter]
    public bool IsEdit { get; set; }

    private MudForm? _form;
    private bool _loading;

    private readonly CourseFormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        _model.Id = Model?.Id;
        _model.MajorId = Model?.MajorId;
        _model.Title = Model?.Title ?? string.Empty;
        _model.Code = Model?.Code ?? string.Empty;
        _model.Units = Model?.Units ?? 3;
        _model.EnrollmentScope = Model?.EnrollmentScope
            ?? Common.Enums.CourseEnrollmentScope.OwningMajorOnly;
        _model.IsActive = Model?.IsActive ?? true;

        _loading = true;

        try
        {
            var response =
                await Http.GetFromJsonAsync<PagedMajorsResponse>(
                    "api/reference-data/majors?pageNumber=1&pageSize=100");

            _model.Majors = response?.Items
                .Select(x => new LookupItemVm
                {
                    Id = x.Id,
                    Title = x.Title
                })
                .ToList()
                ?? [];
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(
                "دریافت رشته‌ها ناموفق بود.",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    protected override string CreateEndpoint =>
        "api/courses";

    protected override string GetUpdateEndpoint(
        CourseFormModel model) =>
        $"api/courses/{model.Id}";

    protected override string CreateSuccessMessage =>
        "درس ثبت شد.";

    protected override string UpdateSuccessMessage =>
        "اطلاعات درس ویرایش شد.";

    protected override object CreateRequest(
        CourseFormModel model)
    {
        return new
        {
            MajorId = model.MajorId!.Value,
            model.Title,
            model.Code,
            model.Units,
            model.EnrollmentScope
        };
    }

    protected override object UpdateRequest(
        CourseFormModel model)
    {
        return new
        {
            Id = model.Id!.Value,
            MajorId = model.MajorId!.Value,
            model.Title,
            model.Code,
            model.Units,
            model.EnrollmentScope,
            model.IsActive
        };
    }

    private async Task SubmitAsync()
    {
        if (_form is null || IsBusy)
            return;

        await _form.Validate();

        if (!_form.IsValid)
            return;

        if (!ModelIsValid())
            return;

        _model.Title = _model.Title.Trim();
        _model.Code = _model.Code.Trim();

        await SaveAsync(_model, IsEdit);
    }

    private bool ModelIsValid()
    {
        if (!_model.MajorId.HasValue)
        {
            Snackbar.Add(
                "انتخاب رشته الزامی است.",
                Severity.Warning);

            return false;
        }

        return true;
    }

    private sealed class PagedMajorsResponse
    {
        public List<MajorLookupItem> Items { get; set; } = [];

        public int TotalCount { get; set; }
    }

    private sealed class MajorLookupItem
    {
        public Guid Id { get; set; }

        public string Title { get; set; } = string.Empty;
    }
}