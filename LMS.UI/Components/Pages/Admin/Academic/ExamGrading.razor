@page "/admin/academic/exams/{ExamId:guid}/grading"
@using Common.Security
@using Common.Enums
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Permissions.Exams.Grade)]
@using System.Net.Http.Json

@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">ارسال‌ها</MudText>
            <MudList T="SubmissionVm" Dense="true">
                @foreach (var item in _submissions)
                {
                    <MudListItem T="SubmissionVm" OnClick="@(() => SelectSubmissionAsync(item))">
                        @item.StudentFullName - تلاش @item.AttemptNumber
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4">
            @if (_selected is null)
            {
                <MudAlert Severity="Severity.Info">ارسالی انتخاب نشده است.</MudAlert>
            }
            else
            {
                <MudText Typo="Typo.h6">@_selected.StudentFullName - @_selected.StudentNumber</MudText>
                <MudText Typo="Typo.caption">نمره فعلی: @_selected.TotalScore</MudText>

                <MudDivider Class="my-3" />

                @foreach (var answer in _selected.Answers)
                {
                    <MudPaper Class="pa-3 mb-3" Outlined="true">
                        <MudText Typo="Typo.subtitle1">@answer.QuestionTitle</MudText>
                        <MudText Typo="Typo.caption">حداکثر نمره: @answer.MaxScore</MudText>

                        @if (answer.Type == QuestionType.MultipleChoice)
                        {
                            <MudText Class="mt-2">پاسخ انتخابی: @answer.SelectedOptionText</MudText>
                            <MudText>نمره: @answer.AwardedScore</MudText>
                        }
                        else
                        {
                            <MudText Class="mt-2">متن پاسخ:</MudText>
                            <MudText>@answer.EssayText</MudText>

                            @if (!string.IsNullOrWhiteSpace(answer.EssayAttachmentPath))
                            {
                                <MudLink Href="@($"{_apiBase}{answer.EssayAttachmentPath}")" Target="_blank">
                                    دانلود فایل پاسخ
                                </MudLink>
                            }

                            <MudNumericField T="decimal?" @bind-Value="answer.AwardedScore" Label="نمره" Variant="Variant.Outlined" Class="mt-2" />
                            <MudButton Class="mt-2" OnClick="@(() => GradeAsync(answer))">ثبت نمره</MudButton>
                        }
                    </MudPaper>
                }
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public Guid ExamId { get; set; }

    [Inject] private IConfiguration Configuration { get; set; } = default!;
    private string _apiBase = "";

    private List<SubmissionVm> _submissions = new();
    private SubmissionDetailsVm? _selected;

    protected override async Task OnInitializedAsync()
    {
        _apiBase = Configuration["ApiBaseUrl"]?.TrimEnd('/') ?? "";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _submissions = await Http.GetFromJsonAsync<List<SubmissionVm>>($"api/exams/{ExamId}/submissions") ?? new();
    }

    private async Task SelectSubmissionAsync(SubmissionVm vm)
    {
        _selected = await Http.GetFromJsonAsync<SubmissionDetailsVm>($"api/exams/submissions/{vm.SubmissionId}");
    }

    private async Task GradeAsync(AnswerVm answer)
    {
        var response = await Http.PutAsJsonAsync($"api/exams/answers/{answer.AnswerId}/grade", new
        {
            AwardedScore = answer.AwardedScore ?? 0m
        });

        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await WebUi.Services.ApiErrorReader.ReadErrorAsync(response), Severity.Error);
            return;
        }

        Snackbar.Add("نمره ثبت شد.", Severity.Success);
        if (_selected is not null)
            _selected = await Http.GetFromJsonAsync<SubmissionDetailsVm>($"api/exams/submissions/{_selected.SubmissionId}");
    }

    private sealed class SubmissionVm
    {
        public Guid SubmissionId { get; set; }
        public string StudentFullName { get; set; } = "";
        public string StudentNumber { get; set; } = "";
        public int AttemptNumber { get; set; }
    }

    private sealed class SubmissionDetailsVm
    {
        public Guid SubmissionId { get; set; }
        public string StudentFullName { get; set; } = "";
        public string StudentNumber { get; set; } = "";
        public decimal? TotalScore { get; set; }
        public List<AnswerVm> Answers { get; set; } = new();
    }

    private sealed class AnswerVm
    {
        public Guid AnswerId { get; set; }
        public Guid QuestionId { get; set; }
        public string QuestionTitle { get; set; } = "";
        public QuestionType Type { get; set; }
        public decimal MaxScore { get; set; }
        public string? SelectedOptionText { get; set; }
        public string? EssayText { get; set; }
        public string? EssayAttachmentFileName { get; set; }
        public string? EssayAttachmentPath { get; set; }
        public decimal? AwardedScore { get; set; }
    }
}