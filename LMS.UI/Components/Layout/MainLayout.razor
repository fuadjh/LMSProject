@inherits LayoutComponentBase

<MudRTLProvider RightToLeft="true">
    <MudThemeProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />
    <MudPopoverProvider/>
    <MudLayout>
        @* AppBar با فاصله از بالا و لبه‌های گرد *@
       
      

        @* سایدبار با فضای خالی برای لوگو *@
        <MudDrawer @bind-Open="_drawerOpen"
                   Elevation="2"
                   Variant="DrawerVariant.Responsive"
                   Class="custom-drawer">
            @* فضای خالی برای لوگو *@
            <div class="logo-container">
                <MudAvatar Size="Size.Large" Variant="Variant.Outlined" Class="logo-avatar">
                    <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Large" Color="Color.Primary" />
                </MudAvatar>
                <span class="logo-text">سامانه آموزش</span>
            </div>

            @* منوی اصلی *@
        <NavMenu/>
        </MudDrawer>
     
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Large" Class="my-8">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</MudRTLProvider>

@code {
    private bool _drawerOpen = true;

    private int totalUnits = 14;
    private int totalCourses = 5;
    private int newAssignments = 3;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}