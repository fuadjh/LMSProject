@page "/admin/security/roles/{RoleId:guid}/permissions"
@using Common.Security
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Permissions.Security.RolesManage)]
@using System.Net.Http.Json
@using MudBlazor

@inject HttpClient Http
@inject ISnackbar Snackbar

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">مجوزهای نقش</MudText>

    <MudList T="string" Dense="true" Class="mt-3">
        @foreach (var p in _allPermissions)
        {
            <MudListItem>
                <MudCheckBox T="bool" Checked="@_selected.Contains(p)" CheckedChanged="@((bool v) => Toggle(p, v))" />
                <MudText Class="ms-2">@p</MudText>
            </MudListItem>
        }
    </MudList>

    <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">ذخیره</MudButton>
</MudPaper>

@code {
    [Parameter] public Guid RoleId { get; set; }

    private List<string> _allPermissions = new();
    private HashSet<string> _selected = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _allPermissions = await Http.GetFromJsonAsync<List<string>>("api/roles/permissions/catalog") ?? new();
        var current = await Http.GetFromJsonAsync<List<string>>($"api/roles/{RoleId}/permissions") ?? new();
        _selected = current.ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private void Toggle(string permission, bool value)
    {
        if (value) _selected.Add(permission);
        else _selected.Remove(permission);
    }

    private async Task SaveAsync()
    {
        var response = await Http.PutAsJsonAsync($"api/roles/{RoleId}/permissions", new
        {
            Permissions = _selected.ToArray()
        });

        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await WebUi.Services.ApiErrorReader.ReadErrorAsync(response), Severity.Error);
            return;
        }

        Snackbar.Add("مجوزهای نقش ذخیره شد.", Severity.Success);
    }
}