@using MudBlazor
@using WebUi.Components.Crud

@inherits CrudDeleteDialogBase<Guid>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            حذف دانشکده
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudText>
            آیا از حذف دائمی دانشکده «@ItemTitle» مطمئن هستید؟
        </MudText>

        <MudAlert Severity="Severity.Warning"
                  Variant="Variant.Outlined"
                  Dense="true"
                  Class="mt-3">
            این عملیات غیرقابل بازگشت است.
        </MudAlert>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   Disabled="IsBusy"
                   OnClick="CancelDialog">
            انصراف
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   Disabled="IsBusy"
                   OnClick="DeleteAsync">

            @if (IsBusy)
            {
                <MudProgressCircular Indeterminate="true"
                                     Size="Size.Small"
                                     Class="me-2" />
            }

            حذف دائمی
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    protected override string GetDeleteEndpoint(Guid id) =>
        $"api/reference-data/faculties/{id}";

    protected override string DeleteSuccessMessage =>
        "دانشکده حذف شد.";
}