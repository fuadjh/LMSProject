@page "/admin/education-experts/create"
@using Common.Security
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Permissions.EducationExperts.Create)]
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">افزودن کارشناس آموزش</MudText>

    <MudGrid Class="mt-2">
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.FirstName" Label="نام" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.LastName" Label="نام خانوادگی" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.UserName" Label="نام کاربری" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.Email" Label="ایمیل" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.Password" Label="رمز عبور" InputType="InputType.Password" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.EmployeeCode" Label="کد کارمندی" Variant="Variant.Outlined" /></MudItem>
    </MudGrid>

    <MudButton Class="mt-4" Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync">ثبت کارشناس</MudButton>
</MudPaper>

@code {
    private CreateEducationExpertVm _model = new();

    private async Task SubmitAsync()
    {
        var response = await Http.PostAsJsonAsync("api/education-experts", _model);
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await WebUi.Services.ApiErrorReader.ReadErrorAsync(response), Severity.Error);
            return;
        }

        Snackbar.Add("کارشناس آموزش ایجاد شد.", Severity.Success);
        _model = new();
    }

    private sealed class CreateEducationExpertVm
    {
        public string UserName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string EmployeeCode { get; set; } = "";
    }
}