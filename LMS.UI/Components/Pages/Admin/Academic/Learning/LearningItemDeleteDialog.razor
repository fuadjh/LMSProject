@using MudBlazor
@using WebUi.Components.Crud

@inherits CrudDeleteDialogBase<Guid>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            حذف محتوای آموزشی
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudText>
            آیا از حذف محتوای «@ItemTitle» مطمئن هستید؟
        </MudText>

        <MudText Typo="Typo.caption"
                 Color="Color.Warning"
                 Class="mt-2">
            اطلاعات پیشرفت و تکمیل دانشجویان برای این محتوا نیز حذف خواهد شد.
        </MudText>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   Disabled="IsBusy"
                   OnClick="CancelDialog">
            انصراف
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   Disabled="IsBusy"
                   OnClick="DeleteAsync">

            @if (IsBusy)
            {
                <MudProgressCircular Indeterminate="true"
                                     Size="Size.Small"
                                     Class="me-2" />
            }

            حذف محتوا
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    protected override string GetDeleteEndpoint(Guid id) =>
        $"api/learning-content/items/{id}";

    protected override string DeleteSuccessMessage =>
        "محتوای آموزشی با موفقیت حذف شد.";
}