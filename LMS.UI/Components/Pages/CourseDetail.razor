        documentFiles.Where(MatchesContentFilter);

    private List<GradeItemModel> gradedItems =>
        gradeItems.Where(x => x.Score.HasValue).ToList();

    private int PendingGradeCount =>
        gradeItems.Count(x => !x.Score.HasValue);

    private int AverageProgress =>
        chapters.Any() ? (int)Math.Round(chapters.Average(x => x.Progress)) : 0;

    private double CurrentAverage =>
        gradedItems.Any() ? Math.Round(gradedItems.Average(x => x.Score ?? 0), 2) : 0;

    private double CurrentAveragePercent =>
        CurrentAverage * 5;

