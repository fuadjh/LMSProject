    private void OnChapterFilterChanged(int value)
    {
        selectedChapterFilter = value;
        selectedSessionFilter = 0;
    }

    private void OnSessionFilterChanged(int value)
    {
        selectedSessionFilter = value;
    }

    private bool MatchesContentFilter(VideoFileModel item)
    {
        var chapterMatch = selectedChapterFilter == 0 || item.ChapterId == selectedChapterFilter;
        var sessionMatch = selectedSessionFilter == 0 || item.SessionId == selectedSessionFilter;
        return chapterMatch && sessionMatch;
    }

    private bool MatchesContentFilter(DocumentFileModel item)
    {
        var chapterMatch = selectedChapterFilter == 0 || item.ChapterId == selectedChapterFilter;
        var sessionMatch = selectedSessionFilter == 0 || item.SessionId == selectedSessionFilter;
        return chapterMatch && sessionMatch;
    }

    private int GetChapterVideoCount(int chapterId) =>
        videoFiles.Count(x => x.ChapterId == chapterId);

    private int GetChapterDocumentCount(int chapterId) =>
        documentFiles.Count(x => x.ChapterId == chapterId);

    private int GetChapterAssignmentCount(int chapterId) =>
        assignments.Count(x => x.ChapterId == chapterId);

    private int GetChapterExamCount(int chapterId) =>
        exams.Count(x => x.ChapterId == chapterId);

    private List<string> GetSessionContentBadges(int sessionId)
    {
        var result = new List<string>();

        var videoCount = videoFiles.Count(x => x.SessionId == sessionId);
        var docCount = documentFiles.Count(x => x.SessionId == sessionId);
        var assignmentCount = assignments.Count(x => x.SessionId == sessionId);
        var examCount = exams.Count(x => x.SessionId == sessionId);

        if (videoCount > 0) result.Add($"{videoCount} ویدئو");
        if (docCount > 0) result.Add($"{docCount} فایل");
        if (assignmentCount > 0) result.Add($"{assignmentCount} تکلیف");
        if (examCount > 0) result.Add($"{examCount} آزمون");

        return result;
    }

    private Color GetProgressColor(int progress)
    {
        return progress switch
        {
            (< 40) => Color.Error,
            < 70 => Color.Warning,
            _ => Color.Success
        };
    }

    private Color GetAssignmentColor(string status)
    {
        return status switch
        {
            "در انتظار تحویل" => Color.Warning,
            "فعال" => Color.Info,
            "جدید" => Color.Primary,
            _ => Color.Default
        };
    }

    private Color GetExamColor(string status)
    {
        return status switch
        {
            "برگزار شده" => Color.Success,
            "فعال" => Color.Warning,
            "آتی" => Color.Info,
            _ => Color.Default
        };
    }

    private Color GetGradeStatusColor(string status)
    {
        return status switch
        {
            "ثبت شده" => Color.Success,
            "در انتظار" => Color.Warning,
            _ => Color.Default
