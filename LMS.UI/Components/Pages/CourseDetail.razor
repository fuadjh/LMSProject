    private void OnAiPromptChanged(string value)
    {
        aiPrompt = value;
    }

    private async Task SendAiMessage()
    {
        if (string.IsNullOrWhiteSpace(aiPrompt))
            return;

        var userText = aiPrompt.Trim();

        aiMessages.Add(new AiMessageModel
        {
            IsUser = true,
            Text = userText
        });

        aiPrompt = string.Empty;
        aiLoading = true;
        StateHasChanged();

        await Task.Delay(600);

        aiMessages.Add(new AiMessageModel
        {
            IsUser = false,
            Text = BuildAiAnswer(userText)
        });

        aiLoading = false;
    }

    private string BuildAiAnswer(string prompt)
    {
        return $"برای موضوع «{prompt}» پیشنهاد می‌کنم ابتدا جلسه‌های مرتبط را در تب «فصل‌ها و جلسات» مرور کنید، سپس ویدئو و فایل همان جلسه را ببینید و در پایان تکلیف یا آزمون مرتبط را حل کنید. اگر بخواهید، می‌توانم همین موضوع را به صورت خلاصه، برنامه مطالعه یا نکات امتحانی هم بازنویسی کنم.";
    }

