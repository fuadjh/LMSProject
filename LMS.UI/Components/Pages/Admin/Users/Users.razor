@page "/admin/users"
@using System.Net.Http.Json
@using Application.Common.Models
@using Common.Enums
@using MudBlazor
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>مدیریت کاربران</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Justify="Justify.SpaceBetween"
              Class="mb-4">

        <MudText Typo="Typo.h5">
            مدیریت کاربران
        </MudText>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="CreateAsync">
            کاربر جدید
        </MudButton>
    </MudStack>

    <MudGrid Class="mb-3">
        <MudItem xs="12" md="4">
            <MudSelect T="UserRoleType"
                       Label="نوع کاربر"
                       @bind-Value="_role"
                       ValueChanged="RoleChangedAsync">
                <MudSelectItem Value="UserRoleType.Student">
                    دانشجو
                </MudSelectItem>
                <MudSelectItem Value="UserRoleType.Instructor">
                    مدرس
                </MudSelectItem>
                <MudSelectItem Value="UserRoleType.EducationExpert">
                    کارشناس آموزش
                </MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudTextField T="string"
                          Label="جست‌وجو"
                          Placeholder="نام، نام کاربری، کد ملی یا موبایل"
                          @bind-Value="_search"
                          Immediate="true"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          OnAdornmentClick="ReloadAsync" />
        </MudItem>

        <MudItem xs="12" md="2">
            <MudButton FullWidth="true"
                       Variant="Variant.Outlined"
                       OnClick="ReloadAsync">
                جست‌وجو
            </MudButton>
        </MudItem>
    </MudGrid>

    <MudTable T="UserProfileListItemDto"
              @ref="_table"
              ServerData="LoadAsync"
              Hover="true"
              Dense="true"
              Striped="true">

        <HeaderContent>
            <MudTh>نام و نام خانوادگی</MudTh>
            <MudTh>نام کاربری</MudTh>
            <MudTh>کد ملی</MudTh>
            <MudTh>شماره همراه</MudTh>
            <MudTh>وضعیت</MudTh>
            <MudTh>عملیات</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="نام">
                @context.FullName
            </MudTd>

            <MudTd DataLabel="نام کاربری">
                @context.UserName
            </MudTd>

            <MudTd DataLabel="کد ملی">
                @context.NationalCode
            </MudTd>

            <MudTd DataLabel="شماره همراه">
                @context.PhoneNumber
            </MudTd>

            <MudTd DataLabel="وضعیت">
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@(context.IsActive
                             ? Color.Success
                             : Color.Error)">
                    @(context.IsActive ? "فعال" : "غیرفعال")
                </MudChip>
            </MudTd>

            <MudTd DataLabel="عملیات">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               OnClick="@(() => EditAsync(context))" />

                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               OnClick="@(() => DeleteAsync(context))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">
                کاربری پیدا نشد.
            </MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private MudTable<UserProfileListItemDto>? _table;
    private UserRoleType _role = UserRoleType.Student;
    private string? _search;

    private async Task<TableData<UserProfileListItemDto>> LoadAsync(
        TableState state,
        CancellationToken cancellationToken)
    {
        var page = state.Page + 1;
        var descending =
            state.SortDirection == SortDirection.Descending;

        var url =
            $"api/users?role={_role}" +
            $"&page={page}" +
            $"&pageSize={state.PageSize}" +
            $"&sortBy={Uri.EscapeDataString(state.SortLabel ?? string.Empty)}" +
            $"&descending={descending}" +
            $"&search={Uri.EscapeDataString(_search ?? string.Empty)}";

        var response =
            await Http.GetFromJsonAsync<
                PagedResponse<UserProfileListItemDto>>(
                url,
                cancellationToken);

        return new TableData<UserProfileListItemDto>
        {
            Items = response?.Items ?? [],
            TotalItems = response?.TotalCount ?? 0
        };
    }

    private async Task CreateAsync()
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { x => x.Role, _role }
        };

        var dialog = await DialogService.ShowAsync<UserDialog>(
            "ایجاد کاربر",
            parameters,
            new DialogOptions
            {
                FullWidth = true,
                MaxWidth = MaxWidth.Medium,
                CloseButton = true
            });

        var result = await dialog.Result;

        if (result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task EditAsync(UserProfileListItemDto user)
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { x => x.UserId, user.UserId },
            { x => x.Role, user.Role }
        };

        var dialog = await DialogService.ShowAsync<UserDialog>(
            "ویرایش کاربر",
            parameters,
            new DialogOptions
            {
                FullWidth = true,
                MaxWidth = MaxWidth.Medium,
                CloseButton = true
            });

        var result = await dialog.Result;

        if (result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task DeleteAsync(UserProfileListItemDto user)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "حذف کاربر",
            $"آیا از حذف «{user.FullName}» مطمئن هستید؟",
            yesText: "حذف",
            cancelText: "انصراف");

        if (confirmed != true)
            return;

        var response =
            await Http.DeleteAsync($"api/users/{user.UserId}");

        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add("حذف کاربر ناموفق بود.", Severity.Error);
            return;
        }

        Snackbar.Add("کاربر حذف شد.", Severity.Success);
        await ReloadAsync();
    }

    private async Task RoleChangedAsync(UserRoleType role)
    {
        _role = role;
        await ReloadAsync();
    }

    private Task ReloadAsync() =>
        _table?.ReloadServerData() ?? Task.CompletedTask;
}