@page "/admin/students/create"
@using Common.Security
@using MudBlazor
@using WebUi.Components.Pages.Admin.Users

@attribute [Microsoft.AspNetCore.Authorization.Authorize(
    Policy = Permissions.Students.Create)]
@inject UserManagementApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>افزودن دانشجو</PageTitle>

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">
        افزودن دانشجو
    </MudText>

    <EditForm Model="_model"
              OnValidSubmit="SubmitAsync">

        <DataAnnotationsValidator />

        <PersonIdentityFields Model="_model"
                              ExistingPerson="_existingPerson"
                              Busy="_checkingNationalCode"
                              OnCheckNationalCode="CheckNationalCodeAsync" />

        @if (_existingPerson?.HasStudentProfile == true)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">
                این شخص قبلاً دارای پروفایل دانشجویی است.
            </MudAlert>
        }

        <MudGrid Class="mt-4">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.StudentNumber"
                              Label="شماره دانشجویی"
                              Variant="Variant.Outlined"
                              For="@(() => _model.StudentNumber)" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="Guid?"
                           Value="_facultyId"
                           ValueChanged="FacultyChangedAsync"
                           Label="دانشکده"
                           Variant="Variant.Outlined">

                    @foreach (var faculty in _faculties)
                    {
                        <MudSelectItem T="Guid?"
                                       Value="@((Guid?)faculty.Id)">
                            @faculty.Title
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="Guid?"
                           @bind-Value="_model.MajorId"
                           Label="رشته"
                           Variant="Variant.Outlined"
                           For="@(() => _model.MajorId)">

                    @foreach (var major in _majors)
                    {
                        <MudSelectItem T="Guid?"
                                       Value="@((Guid?)major.Id)">
                            @major.Title
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudButton Class="mt-4"
                   ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="_saving || _existingPerson?.HasStudentProfile == true">
            @(_saving ? "در حال ثبت..." : "ثبت دانشجو")
        </MudButton>
    </EditForm>
</MudPaper>

@code {
    private readonly CreateStudentVm _model = new();

    private Guid? _facultyId;
    private bool _checkingNationalCode;
    private bool _saving;

    private ExistingPersonVm? _existingPerson;

    private IReadOnlyCollection<LookupVm> _faculties =
        Array.Empty<LookupVm>();

    private IReadOnlyCollection<LookupVm> _majors =
        Array.Empty<LookupVm>();

    protected override async Task OnInitializedAsync()
    {
        _faculties =
            await ApiClient.GetFacultiesAsync();
    }

    private async Task CheckNationalCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.NationalCode))
        {
            Snackbar.Add(
                "کد ملی را وارد کنید.",
                Severity.Warning);

            return;
        }

        _checkingNationalCode = true;

        try
        {
            _existingPerson =
                await ApiClient.GetByNationalCodeAsync(
                    _model.NationalCode);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _checkingNationalCode = false;
        }
    }

    private async Task FacultyChangedAsync(
        Guid? facultyId)
    {
        _facultyId = facultyId;
        _model.MajorId = null;
        _majors = Array.Empty<LookupVm>();

        if (!facultyId.HasValue)
            return;

        _majors =
            await ApiClient.GetMajorsAsync(
                facultyId.Value);
    }

    private async Task SubmitAsync()
    {
        _saving = true;

        try
        {
            await ApiClient.CreateStudentAsync(_model);

            Snackbar.Add(
                "پروفایل دانشجویی ثبت شد.",
                Severity.Success);

            Navigation.NavigateTo("/admin/students");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}