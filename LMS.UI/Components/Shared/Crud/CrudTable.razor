@typeparam TItem
@using MudBlazor

<MudTable T="TItem"
          @ref="_table"
          Items="@(ServerData is null ? Items : null)"
          ServerData="ServerData"
          Dense="true"
          Hover="true"
          Striped="true"
          Bordered="true"
          Loading="Loading"
          RowsPerPage="RowsPerPage"
          Breakpoint="Breakpoint.Sm">

    <HeaderContent>
        @HeaderColumns
        <MudTh Class="text-end">عملیات</MudTh>
    </HeaderContent>

    <RowTemplate>
        @RowColumns(context)

        <MudTd DataLabel="عملیات" Class="text-end">
            @if (OnEdit.HasDelegate)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => OnEdit.InvokeAsync(context))" />
            }

            @if (OnDelete.HasDelegate)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => OnDelete.InvokeAsync(context))" />
            }

            @if (IsActive is not null)
            {
                var active = IsActive(context);

                if (active && OnDeactivate.HasDelegate)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ToggleOff"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   OnClick="@(() => OnDeactivate.InvokeAsync(context))" />
                }
                else if (!active && OnActivate.HasDelegate)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ToggleOn"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   OnClick="@(() => OnActivate.InvokeAsync(context))" />
                }
            }

            @if (AdditionalActions is not null)
            {
                @AdditionalActions(context)
            }
        </MudTd>
    </RowTemplate>

    <LoadingContent>
        <MudText Class="pa-4">
            در حال بارگذاری...
        </MudText>
    </LoadingContent>

    <NoRecordsContent>
        <MudText Class="pa-4">
            رکوردی برای نمایش وجود ندارد.
        </MudText>
    </NoRecordsContent>

    @if (ShowPager)
    {
        <PagerContent>
            <MudTablePager PageSizeOptions="_pageSizeOptions"
                           InfoFormat="{first_item}-{last_item} از {all_items}"
                           RowsPerPageString="تعداد در صفحه" />
        </PagerContent>
    }
</MudTable>

@code {
    private readonly int[] _pageSizeOptions = [10, 20, 50, 100];
    private MudTable<TItem>? _table;

    [Parameter]
    public IEnumerable<TItem> Items { get; set; }
        = Array.Empty<TItem>();

    [Parameter]
    public Func<
        TableState,
        CancellationToken,
        Task<TableData<TItem>>>? ServerData { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public bool ShowPager { get; set; } = true;

    [Parameter]
    public int RowsPerPage { get; set; } = 10;

    [Parameter, EditorRequired]
    public RenderFragment HeaderColumns { get; set; } = default!;

    [Parameter, EditorRequired]
    public RenderFragment<TItem> RowColumns { get; set; } = default!;

    [Parameter]
    public RenderFragment<TItem>? AdditionalActions { get; set; }

    [Parameter]
    public EventCallback<TItem> OnEdit { get; set; }

    [Parameter]
    public EventCallback<TItem> OnDelete { get; set; }

    [Parameter]
    public EventCallback<TItem> OnActivate { get; set; }

    [Parameter]
    public EventCallback<TItem> OnDeactivate { get; set; }

    [Parameter]
    public Func<TItem, bool>? IsActive { get; set; }

    public Task ReloadServerDataAsync()
    {
        return _table?.ReloadServerData()
               ?? Task.CompletedTask;
    }
}