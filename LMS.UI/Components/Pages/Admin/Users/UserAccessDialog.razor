@using MudBlazor
@using WebUi.Components.Pages.Admin.Users
@inject UserManagementApiClient ApiClient
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudText Typo="Typo.h6">
                نقش‌ها و محدوده‌های @_model.FullName
            </MudText>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.subtitle1">
                نقش‌ها
            </MudText>

            <MudGrid Class="mt-2">
                @foreach (var role in _roles)
                {
                    <MudItem xs="12" md="6">
                        <MudCheckBox T="bool"
                                     Checked="@_selectedRoles.Contains(role.Name)"
                                     CheckedChanged="@((bool value) => ToggleRole(role.Name, value))"
                                     Label="@role.Name" />
                    </MudItem>
                }
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.subtitle1">
                دانشکده‌ها
            </MudText>

            <MudGrid Class="mt-2">
                @foreach (var faculty in _faculties)
                {
                    <MudItem xs="12" md="6">
                        <MudCheckBox T="bool"
                                     Checked="@_selectedFacultyIds.Contains(faculty.Id)"
                                     CheckedChanged="@((bool value) => ToggleFacultyAsync(faculty.Id, value))"
                                     Label="@faculty.Title" />
                    </MudItem>
                }
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.subtitle1">
                رشته‌ها
            </MudText>

            @if (_majors.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">
                    ابتدا حداقل یک دانشکده انتخاب کنید.
                </MudAlert>
            }
            else
            {
                <MudGrid Class="mt-2">
                    @foreach (var major in _majors)
                    {
                        <MudItem xs="12" md="6">
                            <MudCheckBox T="bool"
                                         Checked="@_selectedMajorIds.Contains(major.Id)"
                                         CheckedChanged="@((bool value) => ToggleMajor(major.Id, value))"
                                         Label="@major.Title" />
                        </MudItem>
                    }
                </MudGrid>
            }
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text"
                   Disabled="_saving"
                   OnClick="Cancel">
            انصراف
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="_loading || _saving"
                   OnClick="SaveAsync">
            @(_saving ? "در حال ذخیره..." : "ذخیره")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public Guid UserProfileId { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private bool _loading = true;
    private bool _saving;

    private UserAccessDetailsVm _model = new();

    private IReadOnlyCollection<RoleVm> _roles =
        Array.Empty<RoleVm>();

    private IReadOnlyCollection<LookupVm> _faculties =
        Array.Empty<LookupVm>();

    private List<LookupVm> _majors = [];

    private readonly HashSet<string> _selectedRoles =
        new(StringComparer.OrdinalIgnoreCase);

    private readonly HashSet<Guid> _selectedFacultyIds = [];
    private readonly HashSet<Guid> _selectedMajorIds = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _model = await ApiClient.GetAccessAsync(
                UserProfileId);

            _roles = await ApiClient.GetRolesAsync();
            _faculties = await ApiClient.GetFacultiesAsync();

            _selectedRoles.UnionWith(_model.Roles);
            _selectedFacultyIds.UnionWith(_model.FacultyIds);
            _selectedMajorIds.UnionWith(_model.MajorIds);

            await LoadMajorsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            MudDialog.Cancel();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleRole(
        string role,
        bool selected)
    {
        if (selected)
            _selectedRoles.Add(role);
        else
            _selectedRoles.Remove(role);
    }

    private async Task ToggleFacultyAsync(
        Guid facultyId,
        bool selected)
    {
        if (selected)
            _selectedFacultyIds.Add(facultyId);
        else
            _selectedFacultyIds.Remove(facultyId);

        await LoadMajorsAsync();

        var availableMajorIds =
            _majors.Select(x => x.Id).ToHashSet();

        _selectedMajorIds.RemoveWhere(
            id => !availableMajorIds.Contains(id));
    }

    private void ToggleMajor(
        Guid majorId,
        bool selected)
    {
        if (selected)
            _selectedMajorIds.Add(majorId);
        else
            _selectedMajorIds.Remove(majorId);
    }

    private async Task LoadMajorsAsync()
    {
        var majors = new Dictionary<Guid, LookupVm>();

        foreach (var facultyId in _selectedFacultyIds)
        {
            var facultyMajors =
                await ApiClient.GetMajorsAsync(facultyId);

            foreach (var major in facultyMajors)
                majors[major.Id] = major;
        }

        _majors = majors.Values
            .OrderBy(x => x.Title)
            .ToList();
    }

    private async Task SaveAsync()
    {
        _saving = true;

        try
        {
            _model.Roles = _selectedRoles.ToArray();
            _model.FacultyIds = _selectedFacultyIds.ToArray();
            _model.MajorIds = _selectedMajorIds.ToArray();

            await ApiClient.SaveAccessAsync(_model);

            Snackbar.Add(
                "نقش‌ها و محدوده‌های کاربر ذخیره شد.",
                Severity.Success);

            MudDialog.Close(
                DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}