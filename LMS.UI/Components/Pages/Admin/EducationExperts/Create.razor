@page "/admin/education-experts/create"
@using Common.Security
@using MudBlazor
@using WebUi.Components.Pages.Admin.Users

@attribute [Microsoft.AspNetCore.Authorization.Authorize(
    Policy = Permissions.EducationExperts.Create)]
@inject UserManagementApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>افزودن کارشناس آموزش</PageTitle>

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">
        افزودن کارشناس آموزش
    </MudText>

    <EditForm Model="_model"
              OnValidSubmit="SubmitAsync">

        <DataAnnotationsValidator />

        <PersonIdentityFields Model="_model"
                              ExistingPerson="_existingPerson"
                              Busy="_checkingNationalCode"
                              OnCheckNationalCode="CheckNationalCodeAsync" />

        @if (_existingPerson?.HasEducationExpertProfile == true)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">
                این شخص قبلاً دارای پروفایل کارشناس آموزش است.
            </MudAlert>
        }

        <MudGrid Class="mt-4">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.EmployeeCode"
                              Label="کد کارمندی"
                              Variant="Variant.Outlined"
                              For="@(() => _model.EmployeeCode)" />
            </MudItem>
        </MudGrid>

        <MudButton Class="mt-4"
                   ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="_saving || _existingPerson?.HasEducationExpertProfile == true">
            @(_saving ? "در حال ثبت..." : "ثبت کارشناس آموزش")
        </MudButton>
    </EditForm>
</MudPaper>

@code {
    private readonly CreateEducationExpertVm _model = new();

    private ExistingPersonVm? _existingPerson;
    private bool _checkingNationalCode;
    private bool _saving;

    private async Task CheckNationalCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.NationalCode))
        {
            Snackbar.Add(
                "کد ملی را وارد کنید.",
                Severity.Warning);

            return;
        }

        _checkingNationalCode = true;

        try
        {
            _existingPerson =
                await ApiClient.GetByNationalCodeAsync(
                    _model.NationalCode);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _checkingNationalCode = false;
        }
    }

    private async Task SubmitAsync()
    {
        _saving = true;

        try
        {
            await ApiClient.CreateEducationExpertAsync(
                _model);

            Snackbar.Add(
                "پروفایل کارشناس آموزش ثبت شد.",
                Severity.Success);

            Navigation.NavigateTo(
                "/admin/education-experts");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}