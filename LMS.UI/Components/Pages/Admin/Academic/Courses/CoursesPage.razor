@page "/courses"

@using System.Net.Http.Json
@using MudBlazor
@using WebUi.Components.Crud
@using WebUi.Components.Pages.Admin.Academic.Courses

@inherits CrudServerPageBase<CourseListItemVm>

@inject HttpClient Http
@inject ISnackbar Snackbar

<MudPaper Class="pa-4">
    <MudStack Row="true"
              Wrap="Wrap.Wrap"
              Spacing="2"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center">

        <MudText Typo="Typo.h5">
            مدیریت درس‌ها
        </MudText>

        <MudStack Row="true"
                  Wrap="Wrap.Wrap"
                  Spacing="2"
                  AlignItems="AlignItems.Center">

            <MudTextField T="string"
                          @bind-Value="_search"
                          Placeholder="جستجو در عنوان یا کد"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Immediate="true"
                          DebounceInterval="400"
                          OnDebounceIntervalElapsed="SearchAsync"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="min-width: 280px;" />

            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialogAsync">

                ثبت درس
            </MudButton>
        </MudStack>
    </MudStack>

    <MudTable T="CourseListItemVm"
              @ref="CrudTable"
              ServerData="LoadServerDataAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              Bordered="true"
              Loading="_loading"
              Class="mt-4">

        <HeaderContent>
            <MudTh>
                <MudTableSortLabel T="CourseListItemVm"
                                   SortLabel="code">
                    کد
                </MudTableSortLabel>
            </MudTh>

            <MudTh>
                <MudTableSortLabel T="CourseListItemVm"
                                   SortLabel="title">
                    عنوان
                </MudTableSortLabel>
            </MudTh>

            <MudTh>
                رشته
            </MudTh>

            <MudTh>
                واحد
            </MudTh>

            <MudTh>
                محدوده ثبت‌نام
            </MudTh>

            <MudTh>
                وضعیت
            </MudTh>

            <MudTh Class="text-end">
                عملیات
            </MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="کد">
                @context.Code
            </MudTd>

            <MudTd DataLabel="عنوان">
                @context.Title
            </MudTd>

            <MudTd DataLabel="رشته">
                @context.MajorTitle
            </MudTd>

            <MudTd DataLabel="واحد">
                @context.Units
            </MudTd>

            <MudTd DataLabel="محدوده ثبت‌نام">
                @(context.EnrollmentScope ==
                    Common.Enums.CourseEnrollmentScope.AllMajors
                    ? "همه رشته‌ها"
                    : "فقط رشته مالک")
            </MudTd>

            <MudTd DataLabel="وضعیت">
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@(context.IsActive
                                                      ? Color.Success
                                                      : Color.Default)">

                    @(context.IsActive ? "فعال" : "غیرفعال")
                </MudChip>
            </MudTd>

            <MudTd DataLabel="عملیات"
                   Class="text-end">

                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="_loading"
                               OnClick="@(() => OpenEditDialogAsync(context))" />

                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               Disabled="_loading"
                               OnClick="@(() => OpenDeleteDialogAsync(context))" />
            </MudTd>
        </RowTemplate>

        <LoadingContent>
            <div class="pa-6 d-flex justify-center">
                <MudProgressCircular Indeterminate="true"
                                     Color="Color.Primary" />
            </div>
        </LoadingContent>

        <NoRecordsContent>
            <div class="pa-6 d-flex justify-center">
                <MudText>
                    @(_hasSearch
                        ? "موردی مطابق جستجوی شما یافت نشد."
                        : "هنوز درسی ثبت نشده است.")
                </MudText>
            </div>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager PageSizeOptions="_pageSizeOptions"
                           RowsPerPageString="تعداد در صفحه"
                           InfoFormat="{first_item}-{last_item} از {all_items}" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private static readonly int[] _pageSizeOptions = [10, 25, 50];

    private string _search = string.Empty;
    private bool _loading;

    private bool _hasSearch =>
        !string.IsNullOrWhiteSpace(_search);

    private async Task<TableData<CourseListItemVm>> LoadServerDataAsync(
        TableState state,
        CancellationToken cancellationToken)
    {
        _loading = true;

        try
        {
            var pageNumber = state.Page + 1;
            var pageSize = state.PageSize <= 0
                ? 10
                : state.PageSize;

            var sortBy = string.IsNullOrWhiteSpace(state.SortLabel)
                ? "title"
                : state.SortLabel;

            var sortDescending =
                state.SortDirection == SortDirection.Descending;

            var url =
                "api/courses" +
                $"?search={Uri.EscapeDataString(_search)}" +
                $"&pageNumber={pageNumber}" +
                $"&pageSize={pageSize}" +
                $"&sortBy={Uri.EscapeDataString(sortBy)}" +
                $"&sortDescending={sortDescending.ToString().ToLowerInvariant()}";

            var response =
                await Http.GetFromJsonAsync<PagedCoursesResponse>(
                    url,
                    cancellationToken);

            return new TableData<CourseListItemVm>
            {
                Items = response?.Items ?? [],
                TotalItems = response?.TotalCount ?? 0
            };
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
            return new TableData<CourseListItemVm>
            {
                Items = [],
                TotalItems = 0
            };
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(
                "دریافت اطلاعات درس‌ها ناموفق بود.",
                Severity.Error);

            return new TableData<CourseListItemVm>
            {
                Items = [],
                TotalItems = 0
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchAsync(string value)
    {
        _search = value ?? string.Empty;
        await ReloadAsync();
    }

    private Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters<CourseUpsertDialog>
        {
            {
                x => x.Model,
                new CourseFormModel
                {
                    Units = 3,
                    IsActive = true
                }
            },
            {
                x => x.IsEdit,
                false
            }
        };

        return OpenDialogAndReloadAsync<CourseUpsertDialog>(
            "ثبت درس",
            parameters,
            MaxWidth.Medium);
    }

    private Task OpenEditDialogAsync(CourseListItemVm item)
    {
        var parameters = new DialogParameters<CourseUpsertDialog>
        {
            {
                x => x.Model,
                new CourseFormModel
                {
                    Id = item.Id,
                    MajorId = item.MajorId,
                    Title = item.Title,
                    Code = item.Code,
                    Units = item.Units,
                    EnrollmentScope = item.EnrollmentScope,
                    IsActive = item.IsActive
                }
            },
            {
                x => x.IsEdit,
                true
            }
        };

        return OpenDialogAndReloadAsync<CourseUpsertDialog>(
            "ویرایش درس",
            parameters,
            MaxWidth.Medium);
    }

    private Task OpenDeleteDialogAsync(CourseListItemVm item)
    {
        var parameters = new DialogParameters<CourseDeleteDialog>
        {
            {
                x => x.Id,
                item.Id
            },
            {
                x => x.ItemTitle,
                item.Title
            }
        };

        return OpenDialogAndReloadAsync<CourseDeleteDialog>(
            "حذف درس",
            parameters,
            MaxWidth.ExtraSmall);
    }

    private sealed class PagedCoursesResponse
    {
        public List<CourseListItemVm> Items { get; set; } = [];

        public int TotalCount { get; set; }
    }
}