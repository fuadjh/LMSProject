@page "/admin/academic/course-offerings/{OfferingId:guid}/assign-instructor"
@using Common.Security
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Permissions.CourseOfferings.AssignInstructor)]
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>تخصیص استاد</PageTitle>

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">تخصیص استاد به ارائه</MudText>

    @if (_offering is not null)
    {
        <MudText Class="mt-2">@_offering.CourseTitle - @_offering.SemesterTitle</MudText>
        <MudText Typo="Typo.caption">استاد فعلی: @(_offering.InstructorName ?? "-")</MudText>
    }

    <MudTextField @bind-Value="_search" Label="جستجوی استاد" Variant="Variant.Outlined" Class="mt-4" />
    <MudButton Class="mt-2" OnClick="SearchAsync">جستجو</MudButton>

    <MudRadioGroup T="Guid" @bind-Value="_selectedInstructorProfileId" Class="mt-4">
        @foreach (var item in _instructors)
        {
            <MudRadio Value="@item.InstructorProfileId">@($"{item.FullName} - {item.PersonnelCode}")</MudRadio>
        }
    </MudRadioGroup>

    <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">ذخیره</MudButton>
</MudPaper>

@code {
    [Parameter] public Guid OfferingId { get; set; }

    private string _search = "";
    private Guid _selectedInstructorProfileId;
    private OfferingDetailsVm? _offering;
    private List<InstructorVm> _instructors = new();

    protected override async Task OnInitializedAsync()
    {
        _offering = await Http.GetFromJsonAsync<OfferingDetailsVm>($"api/course-offerings/{OfferingId}");
    }

    private async Task SearchAsync()
    {
        _instructors = await Http.GetFromJsonAsync<List<InstructorVm>>(
            $"api/course-offerings/instructors/search?search={Uri.EscapeDataString(_search ?? "")}") ?? new();
    }

    private async Task SaveAsync()
    {
        var response = await Http.PutAsJsonAsync($"api/course-offerings/{OfferingId}/instructor", new
        {
            InstructorProfileId = _selectedInstructorProfileId
        });

        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await WebUi.Services.ApiErrorReader.ReadErrorAsync(response), Severity.Error);
            return;
        }

        Snackbar.Add("استاد تخصیص داده شد.", Severity.Success);
    }

    private sealed class OfferingDetailsVm
    {
        public Guid Id { get; set; }
        public string CourseTitle { get; set; } = "";
        public string SemesterTitle { get; set; } = "";
        public string? InstructorName { get; set; }
    }

    private sealed class InstructorVm
    {
        public Guid InstructorProfileId { get; set; }
        public string FullName { get; set; } = "";
        public string PersonnelCode { get; set; } = "";
    }
}