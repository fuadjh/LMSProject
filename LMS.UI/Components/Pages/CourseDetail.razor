@page "/course/{CourseId:int}"
@rendermode InteractiveServer
@using MudBlazor
@inject NavigationManager NavManager

<div class="lmscourse-page">

    <!-- Hero -->
    <MudPaper Class="lmscourse-hero" Elevation="0">
        <div class="lmscourse-hero-top">
            <div class="lmscourse-hero-main">
                <div class="lmscourse-breadcrumb">
                    <button type="button" class="link-btn" @onclick="GoBack">درس‌های من</button>
                    <span>/</span>
                    <span>@course.Name</span>
                </div>

                <div class="lmscourse-kicker">
                    <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" />
                    <span>Learning Experience</span>
                </div>

                <MudText Typo="Typo.h4" Class="lmscourse-title">@course.Name</MudText>
                <MudText Typo="Typo.body1" Class="lmscourse-subtitle">@course.Description</MudText>

                <div class="lmscourse-meta">
                    <span class="lmscourse-chip">@course.Code</span>
                    <span class="lmscourse-chip">@course.Units واحد</span>
                    <span class="lmscourse-chip">گروه @course.Group</span>
                    <span class="lmscourse-chip">@course.Teacher</span>
                    <span class="lmscourse-chip">@course.Schedule</span>
                </div>
            </div>

            <div class="lmscourse-hero-side">
                <div class="lmscourse-role-switch">
                    <button type="button"
                            class="role-pill @(CurrentRole == CourseRole.Student ? "active" : "")"
                            @onclick="@(() => CurrentRole = CourseRole.Student)">
                        <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" />
                        <span>دانشجو</span>
                    </button>

                    <button type="button"
                            class="role-pill @(CurrentRole == CourseRole.Teacher ? "active" : "")"
                            @onclick="@(() => CurrentRole = CourseRole.Teacher)">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                        <span>استاد</span>
                    </button>
                </div>

                <div class="lmscourse-hero-actions">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="GoBack">
                        بازگشت
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@(CurrentRole == CourseRole.Student ? Icons.Material.Filled.PlayCircle : Icons.Material.Filled.Edit)">
                        @(CurrentRole == CourseRole.Student ? "ادامه یادگیری" : "مدیریت درس")
                    </MudButton>
                </div>
            </div>
        </div>

        <MudGrid Class="lmscourse-stats-grid">
            <MudItem xs="6" md="3">
                <div class="lmscourse-stat-card">
                    <div class="icon primary">
                        <MudIcon Icon="@Icons.Material.Filled.ViewModule" />
                    </div>
                    <div>
                        <div class="value">@chapters.Count</div>
                        <div class="label">فصل</div>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="6" md="3">
                <div class="lmscourse-stat-card">
                    <div class="icon secondary">
                        <MudIcon Icon="@Icons.Material.Filled.Slideshow" />
                    </div>
                    <div>
                        <div class="value">@AllSessions.Count</div>
                        <div class="label">جلسه</div>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="6" md="3">
                <div class="lmscourse-stat-card">
                    <div class="icon info">
                        <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" />
                    </div>
                    <div>
                        <div class="value">@videoFiles.Count</div>
                        <div class="label">محتوای ویدئویی</div>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="6" md="3">
                <div class="lmscourse-stat-card">
                    <div class="icon success">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" />
                    </div>
                    <div>
                        <div class="value">@AverageProgress%</div>
                        <div class="label">پیشرفت کلی</div>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Main Shell -->
    <MudPaper Class="lmscourse-shell" Elevation="0">
        <MudTabs @bind-ActivePanelIndex="activeTab"
                 Rounded="true"
                 BorderBottom="true"
                 Elevation="0"
                 PanelClass="lmscourse-tab-panel">

            <!-- Overview -->
            <MudTabPanel Text="نمای کلی">
                <MudGrid>
                    <MudItem xs="12" lg="8">
                        <MudPaper Class="lmscourse-card" Elevation="0">
                            <div class="lmscourse-section-head">
                                <div>
                                    <MudText Typo="Typo.h6" Class="lmscourse-section-title">خلاصه درس</MudText>
                                    <MudText Typo="Typo.body2" Class="lmscourse-section-subtitle">
                                        اطلاعات کلی، ساختار آموزشی و وضعیت یادگیری
                                    </MudText>
                                </div>
                            </div>

                            <div class="lmscourse-info-grid">
                                <div class="lmscourse-info-item">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" />
                                    <div>
                                        <div class="title">استاد درس</div>
                                        <div class="value">@course.Teacher</div>
                                    </div>
                                </div>

                                <div class="lmscourse-info-item">
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Primary" />
                                    <div>
                                        <div class="title">زمان برگزاری</div>
                                        <div class="value">@course.Schedule</div>
                                    </div>
                                </div>

                                <div class="lmscourse-info-item">
                                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Primary" />
                                    <div>
                                        <div class="title">امتحان نهایی</div>
                                        <div class="value">@course.ExamDate</div>
                                    </div>
                                </div>

                                <div class="lmscourse-info-item">
                                    <MudIcon Icon="@Icons.Material.Filled.Room" Color="Color.Primary" />
                                    <div>
                                        <div class="title">محل برگزاری</div>
                                        <div class="value">@course.Location</div>
                                    </div>
                                </div>
                            </div>
                        </MudPaper>

                        <MudPaper Class="lmscourse-card mt-4" Elevation="0">
                            <div class="lmscourse-section-head">
                                <div>
                                    <MudText Typo="Typo.h6" Class="lmscourse-section-title">مسیر آموزشی درس</MudText>
                                    <MudText Typo="Typo.body2" Class="lmscourse-section-subtitle">
                                        سرفصل‌ها، پیشرفت هر بخش و تعداد منابع مرتبط
                                    </MudText>
                                </div>
                            </div>

                            <div class="lmscourse-overview-modules">
                                @foreach (var chapter in chapters)
                                {
                                    <div class="lmscourse-overview-module">
                                        <div class="module-top">
                                            <div>
                                                <div class="module-title">@chapter.Title</div>
                                                <div class="module-meta">
                                                    @chapter.Sessions.Count جلسه •
                                                    @GetChapterVideoCount(chapter.Id) ویدئو •
                                                    @GetChapterDocumentCount(chapter.Id) فایل •
                                                    @GetChapterAssignmentCount(chapter.Id) تکلیف •
                                                    @GetChapterExamCount(chapter.Id) آزمون
                                                </div>
                                            </div>

                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="@GetProgressColor(chapter.Progress)"
                                                     Variant="Variant.Outlined">
                                                @chapter.Progress%
                                            </MudChip>
                                        </div>

                                        <MudProgressLinear Value="@chapter.Progress"
                                                           Rounded="true"
                                                           Color="@GetProgressColor(chapter.Progress)"
                                                           Class="mt-3" />
                                    </div>
                                }
                            </div>
                        </MudPaper>

                        <MudPaper Class="lmscourse-card mt-4" Elevation="0">
                            <div class="lmscourse-section-head">
                                <div>
                                    <MudText Typo="Typo.h6" Class="lmscourse-section-title">اطلاعیه‌های درس</MudText>
                                    <MudText Typo="Typo.body2" Class="lmscourse-section-subtitle">
                                        آخرین پیام‌ها و اطلاع‌رسانی‌های مربوط به این درس
                                    </MudText>
                                </div>

                                @if (CurrentRole == CourseRole.Teacher)
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                                        اطلاعیه جدید
                                    </MudButton>
                                }
                            </div>

                            <div class="lmscourse-list">
                                @foreach (var item in announcements)
                                {
                                    <div class="lmscourse-list-item">
                                        <div class="list-icon success">
                                            <MudIcon Icon="@Icons.Material.Filled.Campaign" Size="Size.Small" />
                                        </div>
                                        <div class="list-content">
                                            <div class="list-title">@item.Title</div>
                                            <div class="list-subtitle">@item.Description</div>
                                            <div class="list-meta">@item.Date</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" lg="4">
                        <div class="lmscourse-side-stack">
                            <MudPaper Class="lmscourse-card sticky-card" Elevation="0">
                                <div class="lmscourse-section-head compact">
                                    <MudText Typo="Typo.h6" Class="lmscourse-section-title">اقدام سریع</MudText>
                                </div>

                                <div class="lmscourse-action-stack">
                                    @if (CurrentRole == CourseRole.Student)
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.PlayCircle">
                                            ادامه از آخرین جلسه
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Assignment">
                                            مشاهده تکالیف
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" StartIcon="@Icons.Material.Filled.Quiz">
                                            آزمون‌های من
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Add">
                                            افزودن محتوا
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Assignment">
                                            ثبت تکلیف
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" StartIcon="@Icons.Material.Filled.Quiz">
                                            آزمون‌ساز
                                        </MudButton>
                                    }

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Info"
                                               FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.SmartToy"
                                               OnClick="@(() => activeTab = 7)">
                                        دستیار هوشمند
                                    </MudButton>
                                </div>
                            </MudPaper>

                            <MudPaper Class="lmscourse-card mt-4" Elevation="0">
                                <div class="lmscourse-section-head compact">
                                    <MudText Typo="Typo.h6" Class="lmscourse-section-title">ددلاین‌های نزدیک</MudText>
                                </div>

                                <div class="lmscourse-list">
                                    @foreach (var item in deadlines)
                                    {
                                        <div class="lmscourse-list-item">
                                            <div class="list-icon warning">
                                                <MudIcon Icon="@item.Icon" Size="Size.Small" />
                                            </div>
                                            <div class="list-content">
                                                <div class="list-title">@item.Title</div>
                                                <div class="list-subtitle">@item.Reference</div>
                                                <div class="list-meta">@item.DateText</div>
                                            </div>
                                            <MudChip T="string" Size="Size.Small" Color="@item.Color" Variant="Variant.Outlined">
                                                @item.Type
                                            </MudChip>
                                        </div>
                                    }
                                </div>
                            </MudPaper>

                            <MudPaper Class="lmscourse-card mt-4" Elevation="0">
                                <div class="lmscourse-section-head compact">
                                    <MudText Typo="Typo.h6" Class="lmscourse-section-title">آخرین فعالیت‌ها</MudText>
                                </div>

                                <div class="lmscourse-list">
                                    @foreach (var item in recentActivities)
                                    {
                                        <div class="lmscourse-list-item">
                                            <div class="list-icon primary">
                                                <MudIcon Icon="@item.Icon" Size="Size.Small" />
                                            </div>
                                            <div class="list-content">
                                                <div class="list-title">@item.Title</div>
                                                <div class="list-meta">@item.Meta</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </MudPaper>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- Modules -->
            <MudTabPanel Text="فصل‌ها و جلسات">
                <MudPaper Class="lmscourse-card" Elevation="0">
                    <div class="lmscourse-section-head">
                        <div>
                            <MudText Typo="Typo.h6" Class="lmscourse-section-title">ساختار ماژولی درس</MudText>
                            <MudText Typo="Typo.body2" Class="lmscourse-section-subtitle">
                                همه محتواها به تفکیک فصل و جلسه دسته‌بندی شده‌اند
                            </MudText>
                        </div>
                    </div>

                    <MudExpansionPanels>
                        @foreach (var chapter in chapters)
                        {
                            <MudExpansionPanel Dense="true"
                                               Elevation="0"
                                               IsInitiallyExpanded="@(chapter == chapters.First())"
                                               Class="lmscourse-expansion-panel">
                                <TitleContent>
                                    <div class="lmscourse-module-head">
                                        <div>
                                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@chapter.Title</MudText>
                                            <div class="module-meta mt-1">
                                                @chapter.Sessions.Count جلسه •
                                                @GetChapterVideoCount(chapter.Id) ویدئو •
                                                @GetChapterDocumentCount(chapter.Id) فایل •
                                                @GetChapterAssignmentCount(chapter.Id) تکلیف •
                                                @GetChapterExamCount(chapter.Id) آزمون
                                            </div>
                                        </div>

                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="@GetProgressColor(chapter.Progress)">
                                            @chapter.Progress%
                                        </MudChip>
                                    </div>
                                </TitleContent>

                                <ChildContent>
                                    <div class="lmscourse-session-grid">
                                        @foreach (var session in chapter.Sessions)
                                        {
                                            <div class="lmscourse-session-card">
                                                <div class="session-head">
                                                    <div>
                                                        <div class="session-title">جلسه @session.SessionNumber - @session.Title</div>
                                                        <div class="session-meta">@chapter.Title • @session.Duration دقیقه</div>
                                                    </div>
                                                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowForward">
                                                        ورود
                                                    </MudButton>
                                                </div>

                                                <div class="session-pills">
                                                    @foreach (var item in GetSessionContentBadges(session.Id))
                                                    {
                                                        <span class="mini-pill">@item</span>
                                                    }
                                                </div>

                                                <div class="session-inline-items">
                                                    @foreach (var v in videoFiles.Where(x => x.SessionId == session.Id).Take(2))
                                                    {
                                                        <div class="inline-type video">🎬 @v.Title</div>
                                                    }
                                                    @foreach (var d in documentFiles.Where(x => x.SessionId == session.Id).Take(2))
                                                    {
                                                        <div class="inline-type doc">📄 @d.Title</div>
                                                    }
                                                    @foreach (var a in assignments.Where(x => x.SessionId == session.Id).Take(1))
                                                    {
                                                        <div class="inline-type assignment">📝 @a.Title</div>
                                                    }
                                                    @foreach (var e in exams.Where(x => x.SessionId == session.Id).Take(1))
                                                    {
                                                        <div class="inline-type exam">✅ @e.Title</div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                </MudPaper>
            </MudTabPanel>

            <!-- Content -->
            <MudTabPanel Text="محتوا">
                <MudPaper Class="lmscourse-card" Elevation="0">
                    <div class="lmscourse-section-head">
                        <div>
                            <MudText Typo="Typo.h6" Class="lmscourse-section-title">مرور محتوا</MudText>
                            <MudText Typo="Typo.body2" Class="lmscourse-section-subtitle">
                                ویدئوها و فایل‌ها بر اساس فصل و جلسه قابل فیلتر هستند
                            </MudText>
                        </div>
                    </div>

                    <div class="lmscourse-filter-bar">
                        <MudSelect T="int"
                                   Label="فیلتر فصل"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Value="@selectedChapterFilter"
                                   ValueChanged="OnChapterFilterChanged"
                                   Class="filter-select">
                            <MudSelectItem T="int" Value="0">همه فصل‌ها</MudSelectItem>
                            @foreach (var chapter in chapters)
                            {
                                <MudSelectItem T="int" Value="@chapter.Id">@chapter.Title</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="int"
                                   Label="فیلتر جلسه"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Value="@selectedSessionFilter"
                                   ValueChanged="OnSessionFilterChanged"
                                   Class="filter-select">
                            <MudSelectItem T="int" Value="0">همه جلسه‌ها</MudSelectItem>
                            @foreach (var session in FilteredSessionsForSelector)
                            {
                                <MudSelectItem T="int" Value="@session.Id">جلسه @session.SessionNumber - @session.Title</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <MudTabs @bind-ActivePanelIndex="contentTab"
                             Rounded="true"
                             BorderBottom="true"
                             Elevation="0"
                             PanelClass="pt-4">

                        <MudTabPanel Text="ویدئویی">
                            @if (FilteredVideoFiles.Any())
                            {
                                <div class="lmscourse-video-grid">
                                    @foreach (var video in FilteredVideoFiles)
                                    {
                                        <div class="lmscourse-video-card">
                                            <div class="video-cover">
                                                @if (!string.IsNullOrWhiteSpace(video.Cover))
                                                {
                                                    <img src="@video.Cover" alt="@video.Title" />
                                                }
                                                else
                                                {
                                                    <div class="video-placeholder">
                                                        <MudIcon Icon="@Icons.Material.Filled.PlayCircleFilled" Size="Size.Large" Color="Color.Primary" />
                                                    </div>
                                                }

                                                <div class="video-overlay">
                                                    <div class="video-duration">@video.DurationText</div>
                                                    <div class="video-session-info">@video.ChapterTitle • جلسه @video.SessionNumber</div>
                                                </div>
                                            </div>

                                            <div class="video-body">
                                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@video.Title</MudText>

                                                <div class="session-pills mt-2">
                                                    <span class="mini-pill">@video.ChapterTitle</span>
                                                    <span class="mini-pill">جلسه @video.SessionNumber</span>
                                                    <span class="mini-pill">@video.TeacherName</span>
                                                </div>

                                                <div class="video-actions">
                                                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow">
                                                        پخش
                                                    </MudButton>
                                                    <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Visibility">
                                                        جزئیات
                                                    </MudButton>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                    محتوای ویدئویی برای این فیلتر یافت نشد.
                                </MudAlert>
                            }
                        </MudTabPanel>

                        <MudTabPanel Text="غیرویدئویی">
                            @if (FilteredDocumentFiles.Any())
                            {
                                <div class="lmscourse-doc-list">
                                    @foreach (var file in FilteredDocumentFiles)
                                    {
                                        <div class="lmscourse-doc-item">
                                            <div class="doc-icon">
                                                <MudIcon Icon="@GetFileIcon(file.FileType)" Size="Size.Medium" />
                                            </div>

                                            <div class="doc-content">
                                                <div class="doc-title">@file.Title</div>
                                                <div class="doc-meta">@file.ChapterTitle • جلسه @file.SessionNumber • @file.FileType</div>
                                            </div>

                                            <div class="doc-actions">
                                                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download">
                                                    دانلود
                                                </MudButton>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                    فایل غیر ویدئویی برای این فیلتر یافت نشد.
                                </MudAlert>
                            }
                        </MudTabPanel>
                    </MudTabs>
                </MudPaper>
            </MudTabPanel>

            <!-- Assignments -->
            <MudTabPanel Text="تکالیف">
                <MudPaper Class="lmscourse-card" Elevation="0">
                    <div class="lmscourse-section-head">
                        <div>
                            <MudText Typo="Typo.h6" Class="lmscourse-section-title">تکالیف درس</MudText>
                            <MudText Typo="Typo.body2" Class="lmscourse-section-subtitle">
                                هر تکلیف به فصل و جلسه مرتبط متصل شده است
                            </MudText>
                        </div>

                        @if (CurrentRole == CourseRole.Teacher)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                                تکلیف جدید
                            </MudButton>
                        }
                    </div>

                    <div class="lmscourse-task-grid">
                        @foreach (var item in assignments)
                        {
                            <div class="lmscourse-task-card assignment">
                                <div class="task-head">
                                    <div>
                                        <div class="task-title">@item.Title</div>
                                        <div class="task-meta">@item.ChapterTitle • جلسه @item.SessionNumber</div>
                                    </div>

                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="@GetAssignmentColor(item.Status)">
                                        @item.Status
                                    </MudChip>
                                </div>

                                <MudText Typo="Typo.body2" Class="mb-3">@item.Description</MudText>

                                <div class="session-pills">
                                    <span class="mini-pill">مهلت: @item.Deadline</span>
                                    <span class="mini-pill">امتیاز: @item.Score</span>
                                </div>

                                <div class="task-actions">
                                    @if (CurrentRole == CourseRole.Student)
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile">
                                            ارسال پاسخ
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Visibility">
                                            مشاهده
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FactCheck">
                                            بررسی پاسخ‌ها
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit">
                                            ویرایش
                                        </MudButton>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </MudPaper>
            </MudTabPanel>

            <!-- Exams -->
            <MudTabPanel Text="آزمون‌ها">
                <MudPaper Class="lmscourse-card" Elevation="0">
                    <div class="lmscourse-section-head">
                        <div>
                            <MudText Typo="Typo.h6" Class="lmscourse-section-title">آزمون‌ها و کوئیزها</MudText>
                            <MudText Typo="Typo.body2" Class="lmscourse-section-subtitle">
                                آزمون‌ها نیز به فصل و جلسه مشخص متصل شده‌اند
                            </MudText>
                        </div>

                        @if (CurrentRole == CourseRole.Teacher)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Quiz">
                                آزمون‌ساز
                            </MudButton>
                        }
                    </div>

                    <div class="lmscourse-task-grid">
                        @foreach (var exam in exams)
                        {
                            <div class="lmscourse-task-card exam">
                                <div class="task-head">
                                    <div>
                                        <div class="task-title">@exam.Title</div>
                                        <div class="task-meta">@exam.ChapterTitle • جلسه @exam.SessionNumber</div>
                                    </div>

                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="@GetExamColor(exam.Status)">
                                        @exam.Status
                                    </MudChip>
                                </div>

                                <MudText Typo="Typo.body2" Class="mb-3">@exam.Description</MudText>

                                <div class="session-pills">
                                    <span class="mini-pill">تاریخ: @exam.Date</span>
                                    <span class="mini-pill">مدت: @exam.Duration دقیقه</span>
                                    <span class="mini-pill">@exam.QuestionCount سوال</span>
                                </div>

                                <div class="task-actions">
                                    @if (CurrentRole == CourseRole.Student)
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Quiz">
                                            شروع آزمون
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Info">
                                            جزئیات
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Assessment">
                                            نتایج
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit">
                                            ویرایش
                                        </MudButton>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </MudPaper>
            </MudTabPanel>

            <!-- Grades -->
            <MudTabPanel Text="نمرات">
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudPaper Class="lmscourse-card" Elevation="0">
                            <div class="grade-summary-card">
                                <div class="grade-big">@CurrentAverage</div>
                                <div class="grade-label">میانگین فعلی</div>
                                <MudProgressLinear Value="@CurrentAveragePercent"
                                                   Rounded="true"
                                                   Color="Color.Success"
                                                   Class="mt-4" />
                            </div>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudPaper Class="lmscourse-card" Elevation="0">
                            <div class="grade-summary-card">
                                <div class="grade-big">@gradedItems.Count</div>
                                <div class="grade-label">ارزیابی ثبت‌شده</div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                    تکالیف و آزمون‌های نمره‌دار
                                </MudText>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudPaper Class="lmscourse-card" Elevation="0">
                            <div class="grade-summary-card">
                                <div class="grade-big">@PendingGradeCount</div>
                                <div class="grade-label">در انتظار نمره</div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                    مواردی که هنوز ارزیابی نشده‌اند
                                </MudText>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12">
                        <MudPaper Class="lmscourse-card mt-4" Elevation="0">
                            <div class="lmscourse-section-head">
                                <div>
                                    <MudText Typo="Typo.h6" Class="lmscourse-section-title">ریز نمرات</MudText>
                                    <MudText Typo="Typo.body2" Class="lmscourse-section-subtitle">
                                        نمایش جزئیات ارزیابی به تفکیک نوع، فصل و جلسه
                                    </MudText>
                                </div>
                            </div>

                            <div class="lmscourse-grade-list">
                                @foreach (var item in gradeItems)
                                {
                                    <div class="lmscourse-grade-row">
                                        <div class="grade-main">
                                            <div class="grade-title">@item.Title</div>
                                            <div class="grade-meta">@item.Type • @item.ChapterTitle • جلسه @item.SessionNumber</div>
                                        </div>

                                        <div class="grade-score-box">
                                            <div class="score">@item.ScoreText</div>
                                            <MudChip T="string" Size="Size.Small" Color="@GetGradeStatusColor(item.Status)" Variant="Variant.Outlined">
                                                @item.Status
                                            </MudChip>
                                        </div>
                                    </div>
                                }
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- Discussions -->
            <MudTabPanel Text="گفتگوها">
                <MudPaper Class="lmscourse-card" Elevation="0">
                    <div class="lmscourse-section-head">
                        <div>
                            <MudText Typo="Typo.h6" Class="lmscourse-section-title">تالار گفتگو</MudText>
                            <MudText Typo="Typo.body2" Class="lmscourse-section-subtitle">
                                سوال‌ها و گفتگوهای مرتبط با جلسه، تکلیف یا آزمون
                            </MudText>
                        </div>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddComment">
                            سوال جدید
                        </MudButton>
                    </div>

                    <div class="lmscourse-forum-list">
                        @foreach (var topic in forumTopics)
                        {
                            <div class="lmscourse-forum-card">
                                <div class="forum-head">
                                    <div>
                                        <div class="forum-title">@topic.Title</div>
                                        <div class="forum-meta">@topic.ReferenceText</div>
                                    </div>

                                    <div class="forum-side">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@topic.Replies پاسخ</MudChip>
                                        <div class="forum-last">@topic.LastActivity</div>
                                    </div>
                                </div>

                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">
                                    @topic.Description
                                </MudText>

                                <div class="forum-footer">
                                    <div class="session-pills">
                                        <span class="mini-pill">@topic.Author</span>
                                        <span class="mini-pill">@topic.Category</span>
                                    </div>

                                    <MudButton Variant="Variant.Text" Color="Color.Primary">
                                        مشاهده و پاسخ
                                    </MudButton>
                                </div>
                            </div>
                        }
                    </div>
                </MudPaper>
            </MudTabPanel>

            <!-- Calendar -->
            <MudTabPanel Text="تقویم">
                <MudPaper Class="lmscourse-card" Elevation="0">
                    <div class="lmscourse-section-head">
                        <div>
                            <MudText Typo="Typo.h6" Class="lmscourse-section-title">تقویم فعالیت‌ها</MudText>
                            <MudText Typo="Typo.body2" Class="lmscourse-section-subtitle">
                                همه رویدادهای مهم درس در یک نمای زمانی
                            </MudText>
                        </div>
                    </div>

                    <div class="lmscourse-timeline">
                        @foreach (var item in timelineItems)
                        {
                            <div class="timeline-row">
                                <div class="timeline-date">@item.DateText</div>
                                <div class="timeline-dot"></div>
                                <div class="timeline-card">
                                    <div class="timeline-title">@item.Title</div>
                                    <div class="timeline-meta">@item.Reference</div>
                                    <div class="timeline-type">@item.Type</div>
                                </div>
                            </div>
                        }
                    </div>
                </MudPaper>
            </MudTabPanel>

            <!-- AI -->
            <MudTabPanel Text="هوش مصنوعی">
                <MudGrid>
                    <MudItem xs="12" lg="4">
                        <MudPaper Class="lmscourse-card ai-side-card" Elevation="0">
                            <div class="lmscourse-section-head compact">
                                <MudText Typo="Typo.h6" Class="lmscourse-section-title">دستیار هوشمند درس</MudText>
                            </div>

                            <MudText Typo="Typo.body2" Class="mb-4">
                                می‌توانید از هوش مصنوعی برای جمع‌بندی جلسات، برنامه مطالعه، آمادگی آزمون و توضیح مفاهیم کمک بگیرید.
                            </MudText>

                            <div class="lmscourse-action-stack">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="AskForSummary">
                                    خلاصه درس
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="AskForStudyPlan">
                                    برنامه مطالعه
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="AskForExamPrep">
                                    آمادگی آزمون
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Info" FullWidth="true" OnClick="AskForAssignmentsHelp">
                                    کمک برای تکلیف
                                </MudButton>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" lg="8">
                        <MudPaper Class="lmscourse-card ai-chat-card" Elevation="0">
                            <div class="lmscourse-section-head compact">
                                <MudText Typo="Typo.h6" Class="lmscourse-section-title">چت‌بات آموزشی</MudText>
                                @if (aiLoading)
                                {
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                                }
                            </div>

                            <div class="lmscourse-chat-box">
                                @foreach (var msg in aiMessages)
                                {
                                    <div class="chat-row @(msg.IsUser ? "user" : "bot")">
                                        <div class="chat-bubble">
                                            @msg.Text
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="lmscourse-chat-input">
                                <MudTextField T="string"
                                              FullWidth="true"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Placeholder="سوال خود را درباره درس بنویسید..."
                                              Value="@aiPrompt"
                                              ValueChanged="OnAiPromptChanged" />

                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Send"
                                           OnClick="SendAiMessage">
                                    ارسال
                                </MudButton>
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

        </MudTabs>
    </MudPaper>
</div>

