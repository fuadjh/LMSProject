    private async Task AddQuickAiExchange(string userText, string botText)
    {
        aiMessages.Add(new AiMessageModel { IsUser = true, Text = userText });
        aiLoading = true;
        StateHasChanged();

        await Task.Delay(500);

        aiMessages.Add(new AiMessageModel { IsUser = false, Text = botText });
        aiLoading = false;
    }

