@page "/admin/students/create"
@using Common.Security
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Permissions.Students.Create)]
@using System.Net.Http.Json
@using MudBlazor

@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>افزودن دانشجو</PageTitle>


<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">افزودن دانشجو</MudText>

    <MudGrid Class="mt-2">
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.FirstName" Label="نام" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.LastName" Label="نام خانوادگی" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.UserName" Label="نام کاربری" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.Email" Label="ایمیل" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.Password" Label="رمز عبور" InputType="InputType.Password" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.StudentNumber" Label="شماره دانشجویی" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="Guid" Label="دانشکده" @bind-Value="_facultyId" Variant="Variant.Outlined" OnValueChanged="FacultyChanged">
                @foreach (var faculty in _faculties)
                {
                    <MudSelectItem Value="@faculty.Id">@faculty.Title</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="Guid" Label="رشته" @bind-Value="_model.MajorId" Variant="Variant.Outlined">
                @foreach (var major in _majors)
                {
                    <MudSelectItem Value="@major.Id">@major.Title</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudButton Class="mt-4" Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync">ثبت دانشجو</MudButton>
</MudPaper>

 

@code {
    private CreateStudentVm _model = new();
    private Guid _facultyId;
    private List<LookupVm> _faculties = new();
    private List<LookupVm> _majors = new();

    protected override async Task OnInitializedAsync()
    {
        _faculties = await Http.GetFromJsonAsync<List<LookupVm>>("api/reference-data/faculties") ?? new();
    }

    private async Task FacultyChanged(Guid facultyId)
    {
        _facultyId = facultyId;
        _majors = await Http.GetFromJsonAsync<List<LookupVm>>($"api/reference-data/majors?facultyId={facultyId}") ?? new();
        StateHasChanged();
    }

    private async Task SubmitAsync()
    {
        var response = await Http.PostAsJsonAsync("api/students", _model);
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await WebUi.Services.ApiErrorReader.ReadErrorAsync(response), Severity.Error);
            return;
        }

        Snackbar.Add("دانشجو ایجاد شد.", Severity.Success);
        _model = new();
        _majors.Clear();
        _facultyId = Guid.Empty;
    }

    private sealed class CreateStudentVm
    {
        public string UserName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string StudentNumber { get; set; } = "";
        public Guid MajorId { get; set; }
    }

    private sealed class LookupVm
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
    }
}